{
  "name": "drift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "scripts": {
    "edition": "yarn workspace @drift/edition dev",
    "app": "yarn workspace @drift/app android",
    "app:ios": "yarn workspace @drift/app ios",
    "app:start": "yarn workspace @drift/app start",
    "app:prebuild": "yarn workspace @drift/app prebuild",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
