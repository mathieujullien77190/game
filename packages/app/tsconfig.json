{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@drift/engine/*": ["../engine/src/*"],
      "@drift/maps/*": ["../maps/*"],
      "@drift/skia-render": ["../skia-render/src/index.ts"]
    }
  },
  "include": ["App.tsx", "index.js"]
}
