{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@tic-tac-tic/engine/*": ["../engine/src/*"],
      "@tic-tac-tic/maps/*": ["../maps/*"],
      "@tic-tac-tic/canvas-render": ["../canvas-render/src/index.ts"]
    }
  },
  "include": ["App.tsx", "index.js", "src"]
}
