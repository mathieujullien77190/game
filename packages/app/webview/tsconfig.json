{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@tic-tac-tic/engine/*": ["../../engine/src/*"],
      "@tic-tac-tic/canvas-render": ["../../canvas-render/src/index.ts"]
    }
  },
  "include": ["main.ts", "ui/**/*.ts", "vite.config.ts"]
}
